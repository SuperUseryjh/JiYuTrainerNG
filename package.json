{
  "name": "jiyu-trainer-ng",
  "version": "0.1.0",
  "description": "JiYuTrainer 重写魔改版 - 适配极域课堂管理系统 v6.0 2021 豪华版",
  "author": "JiYuTrainerNG",
  "main": "electron/main.js",
  "gypfile": false,
  "scripts": {
    "build:native": "node-gyp rebuild",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "node-addon-api": "^7.1.0",
    "node-gyp": "^10.1.0"
  },
  "build": {
    "appId": "com.jiyu.trainer.ng",
    "productName": "JiYuTrainerNG",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/Release/jiyu_native.node", "to": "jiyu_native.node" },
      { "from": "build/jiyu_inject.dll", "to": "jiyu_inject.dll" }
    ],
    "win": {
      "target": [ "portable", "nsis" ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "MIT"
}
